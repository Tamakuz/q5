{
  "name": "content-auto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "dashboard"
  ],
  "description": "Remotion-based automated content rendering engine for YouTube",
  "scripts": {
    "build": "tsc --noEmit",
    "render": "npx tsx cli.ts render",
    "validate": "npx tsx cli.ts validate",
    "aistudio": "npx tsx playwright/aistudio.ts",
    "gemini": "npx tsx playwright/gemini.ts",
    "gemini:codegen": "npx playwright codegen --user-data-dir=playwright/user_data/user_1 https://gemini.google.com/app",
    "aistudio:init": "npx tsx playwright/initialize.ts",
    "aistudio:prompt": "npx tsx playwright/actions/input-prompt.ts",
    "aistudio:attach": "npx tsx playwright/actions/attach-file.ts",
    "aistudio:drive": "npx tsx playwright/actions/attach-drive-file.ts",
    "aistudio:drive-codegen": "npx tsx playwright/test-attach-drive-only.ts",
    "aistudio:submit": "npx tsx playwright/actions/submit-and-extract.ts",
    "aistudio:pipeline": "npx tsx playwright/pipelines/analysis-pipeline.ts",
    "playwright:init": "npx tsx playwright/cli.ts init-user-data",
    "playwright:check": "npx tsx playwright/cli.ts check-session",
    "playwright:create": "npx tsx playwright/cli.ts create-project",
    "playwright:generate": "npx tsx playwright/cli.ts generate-images",
    "playwright:cli": "npx tsx playwright/cli.ts",
    "keywords:shorts": "npx tsx dashboard/scripts/generate-shorts-keywords.ts"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "commander": "^12.0.0",
    "playwright": "^1.61.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}