{
  "manifest_version": 3,
  "name": "AI Studio Automator Extension",
  "version": "1.0.0",
  "description": "Minimal Chrome Extension for AI Studio Automation",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://docs.google.com/*",
        "https://drive.google.com/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ]
}